# Copy to apps/web/.env.local. No service-role key is used by the web app.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Development preview contains hard-coded fictional data only. Set false to hide.
ENABLE_FICTIONAL_PREVIEW=true

# The assistant service. Leave every line blank to keep it switched off: the conversation
# still reads measurements, stores documents and remembers what a person confirmed, and it
# says plainly that it cannot answer free questions. See docs/ASSISTANT_SERVICE.md for what
# is sent and to whom. Never commit a real key, and never put one in the Windows package.
MED_ASSISTANT_AI_PROVIDER=
MED_ASSISTANT_AI_MODEL=
MED_ASSISTANT_AI_KEY=
# A second, deliberate act: must equal the provider name before anything is transmitted.
MED_ASSISTANT_AI_CONSENT=
